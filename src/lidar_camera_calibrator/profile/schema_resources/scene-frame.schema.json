{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidar-camera-calibrator.dev/schemas/v1/scene-frame.schema.json",
  "title": "lidar-camera.SceneFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame_index", "timestamp_ns", "cameras"],
  "properties": {
    "frame_index": {"type": "integer", "minimum": 0},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "cameras": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["camera_name", "source_timestamp_ns", "synchronization_delta_ns"],
        "properties": {
          "camera_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "source_timestamp_ns": {"type": "integer", "minimum": 0},
          "synchronization_delta_ns": {"type": "integer"}
        }
      }
    }
  }
}
